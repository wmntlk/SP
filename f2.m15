#Program T2S2;
Start Variable Integer32_t A1A1, B1B1, C1C1, M1A1;
Get (A1A1);
Get (B1B1);
Get (C1C1);

If A1A1 !< B1B1 And A1A1 !< C1C1 {
A1A1 :> M1A1;
} Else If B1B1 !< A1A1 And B1B1 !< C1C1 {
B1B1 :> M1A1;
} Else {
C1C1 :> M1A1;
}
Put (M1A1);

If (A1A1 = B1B1) And (A1A1 = C1C1) And (B1B1 = C1C1) {
Put(1);
} Else {
Put (0);
}
If !(A1A1 !< 0) || !(C1C1 !< 0) {
Put(-1);
} Else {
Put (0);
}

If A1A1 !< (B1B1 + C1C1) {
Put (10);
} Else {
Put (0);
}
End
